# Generate a secret: openssl rand -hex 32
GPU_MEDIA_AUTH_TOKEN=REPLACE_WITH_64_CHAR_RANDOM_HEX
# Remain on localhost until private TLS is configured.
GPU_MEDIA_BIND_IP=127.0.0.1
# Heavy jobs remain disabled until cross-service TTS/GPU coordination exists.
GPU_MEDIA_HEAVY_ENABLED=false
# All three must be approved for SDXL; also verify BOTH stacks honor the
# same authenticated coordinator before changing any flag on a live server.
GPU_MEDIA_IMAGE_ENABLED=false
GPU_MEDIA_VIDEO_ENABLED=false
GPU_COORDINATION_ENABLED=false
# With docker-compose.sdxl-cache.yml, the read-only tested cache is mounted
# at /sdxl-cache; model files live in its Hugging Face 'hub' subdirectory.
# GPU_MEDIA_SDXL_CACHE_DIR=/sdxl-cache/hub
# CPU is the safe production default while TTS and GPU media are unscheduled.
# GPU mode was smoke-tested on Tesla T4 with CUDA 12 cuBLAS/cuDNN 9.
GPU_MEDIA_WHISPER_DEVICE=cpu
GPU_MEDIA_WHISPER_COMPUTE_TYPE=int8
