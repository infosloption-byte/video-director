FROM python:3.11-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 GPU_MEDIA_DATA_ROOT=/media/jobs
WORKDIR /app
COPY requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt
COPY media_service ./media_service
RUN mkdir -p /media/jobs
EXPOSE 8010
CMD ["uvicorn", "media_service.api:app", "--host", "0.0.0.0", "--port", "8010", "--workers", "1", "--no-proxy-headers"]
