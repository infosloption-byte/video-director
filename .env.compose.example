# Copy this to `.env` in the repo root (same folder as docker-compose.yml).
# docker-compose reads this automatically.

# Credentials for the SHARED mysql_shared container (same one voxora uses) —
# not a new database server. Ask whoever set that container up for the
# right username/password if root isn't open to other containers.
DB_CONNECTION=mysql
DB_HOST=mysql_shared
DB_PORT=3306
DB_DATABASE=helix
DB_USERNAME=root
DB_PASSWORD=change_me_to_the_shared_mysql_password

# Docker network that the mysql_shared container is attached to. Find it
# with: docker inspect mysql_shared --format '{{json .NetworkSettings.Networks}}'
SHARED_MYSQL_NETWORK=mysql_shared_net
