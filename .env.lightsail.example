# Copy to .env.lightsail, replace both secrets with different values from: openssl rand -hex 32
DB_DATABASE=voxora
DB_USERNAME=voxora_app
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_HEX_SECRET

AUTH_PUBLIC_URL=https://usevoxora.online
AUTH_ALLOWED_ORIGINS=https://usevoxora.online,https://www.usevoxora.online

# Optional. Only set these if the TTS service is reachable from this Lightsail host.
TTS_SERVICE_URL=
TTS_SERVICE_AUTH_TOKEN=
