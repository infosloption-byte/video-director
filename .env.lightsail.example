# Copy to .env.lightsail and replace both placeholders with DIFFERENT values.
# Generate each with: openssl rand -hex 32
DB_DATABASE=voxora
DB_USERNAME=voxora_app
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_HEX_SECRET

AUTH_PUBLIC_URL=https://usevoxora.online
AUTH_ALLOWED_ORIGINS=https://usevoxora.online,https://www.usevoxora.online

# Optional. Only set these if the TTS service is reachable from this Lightsail host.
TTS_SERVICE_URL=
TTS_SERVICE_AUTH_TOKEN=

# Public legal contact fields included in the frontend build. Set a monitored inbox and verified registered business information.
LEGAL_ENTITY_NAME="SL Options"
LEGAL_CONTACT_EMAIL=info.sloptions@gmail.com
LEGAL_BUSINESS_ADDRESS="119, Regency Park, Ranapanadeniya, Rathgama, Sri Lanka"
