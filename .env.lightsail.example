# Copy to .env.lightsail. Generate DB_PASSWORD using: openssl rand -hex 32
# It must match the password assigned to the dedicated voxora_app MySQL user.
DB_DATABASE=voxora
DB_USERNAME=voxora_app
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET

# Existing shared MySQL Docker network used by Buildhire; verify on the server.
SHARED_MYSQL_NETWORK=shared_net

AUTH_PUBLIC_URL=https://usevoxora.online
AUTH_ALLOWED_ORIGINS=https://usevoxora.online,https://www.usevoxora.online

# Optional. Only set these if the TTS service is reachable from this Lightsail host.
TTS_SERVICE_URL=
TTS_SERVICE_AUTH_TOKEN=
