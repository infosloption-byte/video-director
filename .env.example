# Copy to `.env` in the repo root (next to docker-compose.yml).
DB_CONNECTION=mysql
DB_HOST=mysql_shared
DB_PORT=3306
DB_DATABASE=helix
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_shared_mysql_root_password

# The Docker network shared_mysql runs on (created once, shared by every project).
# NOT "mysql_shared_net" -- that was this repo's guess. The real name from your
# earlier setup is:
SHARED_MYSQL_NETWORK=shared_net
