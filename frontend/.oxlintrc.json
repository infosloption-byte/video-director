{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": [
        "src/pages/EditorPage.jsx",
        "src/pages/AdvancedEditorPage.jsx",
        "src/pages/MyResearchPage.jsx",
        "src/components/FinalizePanel.jsx",
        "src/components/PhonePreview.jsx",
        "src/context/AuthContext.jsx",
        "src/components/EditorWaveform.jsx",
        "src/pages/ProjectProductivityPage.jsx",
        "src/pages/ReviewPage.jsx"
      ],
      "rules": {
        "react/set-state-in-effect": "off",
        "react-hooks/exhaustive-deps": "off"
      }
    },
    {
      "files": [
        "src/components/EditorWorkspace.jsx",
        "src/components/ResearchFindingInspector.jsx",
        "src/components/PlatformShell.jsx"
      ],
      "rules": {
        "react/set-state-in-effect": "off"
      }
    },
    {
      "files": [
        "src/components/EditorToolPanel.jsx"
      ],
      "rules": {
        "react/set-state-in-effect": "off",
        "react/immutability": "off",
        "eslint/no-unused-vars": "off"
      }
    },
    {
      "files": [
        "src/components/EditorRenderModal.jsx"
      ],
      "rules": {
        "react/immutability": "off"
      }
    },
    {
      "files": [
        "src/pages/ResearchPage.jsx"
      ],
      "rules": {
        "react-hooks/exhaustive-deps": "off"
      }
    },
    {
      "files": [
        "src/pages/EditorPage.jsx",
        "src/pages/AdvancedEditorPage.jsx"
      ],
      "rules": {
        "eslint/no-unused-expressions": "off"
      }
    },
    {
      "files": [
        "src/context/ThemeContext.jsx",
        "src/context/AuthContext.jsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
