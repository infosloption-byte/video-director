# Copy to server/.env ON THE SERVER. Never commit the real file.
# DATABASE_URL is assembled at container start from the DB_* vars in the
# repo-root .env (see docker-entrypoint.sh) -- do not set it here.
PORT=4000
NODE_ENV=production

REDIS_URL=redis://redis:6379

AUTH_PUBLIC_URL=https://helix.ycusriya.online
AUTH_ALLOWED_ORIGINS=https://helix.ycusriya.online
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax

# Required -- renderService.js refuses to render without it.
RENDER_ASSET_TOKEN=CHANGE_ME_random_hex

RENDER_WORKER_IN_API=true
EDITOR_RENDER_WORKER_IN_API=true

# Fill in whichever providers you actually use (leave blank to skip that feature):
GEMINI_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
PEXELS_API_KEY=

# Dedicated self-hosted TTS EC2 service.
# Use the private IP/DNS name of the c5a.2xlarge TTS instance.
TTS_SERVICE_URL=http://TTS_PRIVATE_IP:8000
TTS_SERVICE_AUTH_TOKEN=CHANGE_ME_TTS_TOKEN
TTS_SERVICE_TIMEOUT_MS=180000
TTS_DEFAULT_ENGINE=kokoro
TTS_DEFAULT_VOICE_ID=
TTS_DEFAULT_LANGUAGE=English
