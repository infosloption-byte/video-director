# Copy to .env and fill in for local dev. See docs/BUILD_PLAN.md §10.
DATABASE_URL="mysql://user:pass@localhost:3306/helix"
PORT=4000
# Optional: set true to refresh suggested signals immediately on API startup.
# The scheduled 4-hour refresh remains enabled either way.
SIGNALS_SCRAPE_ON_START=false

# M2 search sources. Semantic Scholar is free without a key.
TAVILY_API_KEY=""
BRAVE_API_KEY=""

# M3 research brief + M5 storyboard generation.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
PEXELS_API_KEY=""

# M6 narration. ElevenLabs returns audio plus character alignment,
# which Helix converts into word-level timestamps for synced captions.
ELEVENLABS_API_KEY=""
# Optional: leave blank to auto-select an account-available voice.
ELEVENLABS_VOICE_ID=""
ELEVENLABS_MODEL="eleven_multilingual_v2"

# M7 rendering. Redis is used by BullMQ for the render queue.
REDIS_URL="redis://127.0.0.1:6379"
# URL the Remotion renderer uses to fetch local generated audio.
REMOTION_BASE_URL="http://127.0.0.1:4000"
# Keep rendering in its dedicated worker process. Set true only if you explicitly
# want the API process to own the worker (not recommended for long Remotion jobs).
RENDER_WORKER_IN_API="false"
# BullMQ lock for long-running Remotion jobs. Increase if renders can exceed 30 minutes.
RENDER_JOB_LOCK_DURATION_MS="1800000"

# M9 optional Direct-to-Facebook Page publishing.
# Use a Page access token with the required Page publishing permissions.
FACEBOOK_API_VERSION="v25.0"
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
