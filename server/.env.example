# Copy to .env and fill in for local dev. See docs/BUILD_PLAN.md.
DATABASE_URL="mysql://user:pass@localhost:3306/helix"
PORT=4000

SIGNALS_SCRAPE_ON_START=false

TAVILY_API_KEY=""
BRAVE_API_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
PEXELS_API_KEY=""

ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
ELEVENLABS_MODEL="eleven_multilingual_v2"

REDIS_URL="redis://127.0.0.1:6379"
REMOTION_BASE_URL="http://127.0.0.1:4000"
RENDER_WORKER_IN_API="false"
EDITOR_RENDER_WORKER_IN_API="false"
RENDER_JOB_LOCK_DURATION_MS="1800000"
RENDER_ASSET_TOKEN=""

MEDIA_STORAGE_ROOT=""
MEDIA_PROXY_MIN_BYTES="52428800"
MEDIA_PROCESSOR_INTERVAL_MS="15000"
FFMPEG_PATH=""
FFPROBE_PATH=""

# Authentication. Use real accounts for normal operation.
AUTH_REQUIRED="false"
DEV_AUTH_FALLBACK="true"
AUTH_PUBLIC_URL="http://localhost:5173"
AUTH_ALLOWED_ORIGINS="http://localhost:5173"
COOKIE_SECURE="false"
COOKIE_SAMESITE="Lax"

# Expensive-operation abuse protection. Limits are per authenticated user/IP bucket.
SIGNAL_SEARCH_RATE_LIMIT="30"
SIGNAL_SEARCH_RATE_WINDOW_MS="300000"
PROJECT_CREATE_RATE_LIMIT="10"
PROJECT_CREATE_RATE_WINDOW_MS="600000"
PROVIDER_RATE_LIMIT="10"
PROVIDER_RATE_WINDOW_MS="600000"
MEDIA_SEARCH_RATE_LIMIT="20"
MEDIA_SEARCH_RATE_WINDOW_MS="300000"
RENDER_RATE_LIMIT="6"
RENDER_RATE_WINDOW_MS="600000"
EDITOR_RENDER_RATE_LIMIT="6"
EDITOR_RENDER_RATE_WINDOW_MS="600000"

# M9 development-only Facebook publishing; production publishing is intentionally deferred.
FACEBOOK_API_VERSION="v25.0"
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
