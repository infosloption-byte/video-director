# Copy to .env and fill in for local dev. See docs/BUILD_PLAN.md.
DATABASE_URL="mysql://user:pass@localhost:3306/voxora"
PORT=4000

SIGNALS_SCRAPE_ON_START=false

TAVILY_API_KEY=""
BRAVE_API_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_MODEL_FALLBACKS="gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-2.5-flash"
PEXELS_API_KEY=""

# Self-hosted narration service on the dedicated TTS EC2 instance.
# Local development: http://127.0.0.1:8000
# AWS production: use the private DNS/IP of the TTS instance.
TTS_SERVICE_URL="http://127.0.0.1:8000"
TTS_SERVICE_AUTH_TOKEN=""
TTS_SERVICE_TIMEOUT_MS="180000"
TTS_DEFAULT_ENGINE="kokoro"
TTS_DEFAULT_VOICE_ID=""
TTS_DEFAULT_LANGUAGE="English"

REDIS_URL="redis://127.0.0.1:6379"
REMOTION_BASE_URL="http://127.0.0.1:4000"
RENDER_WORKER_IN_API="false"
EDITOR_RENDER_WORKER_IN_API="false"
RENDER_JOB_LOCK_DURATION_MS="1800000"
RENDER_ASSET_TOKEN=""

MEDIA_STORAGE_ROOT=""
MEDIA_PROXY_MIN_BYTES="52428800"
MEDIA_PROCESSOR_INTERVAL_MS="15000"
FFMPEG_PATH=""
FFPROBE_PATH=""

# Authentication. Use real accounts for normal operation.
AUTH_REQUIRED="false"
DEV_AUTH_FALLBACK="true"
AUTH_PUBLIC_URL="http://localhost:5173"
AUTH_ALLOWED_ORIGINS="http://localhost:5173"
COOKIE_SECURE="false"
COOKIE_SAMESITE="Lax"

# Expensive-operation abuse protection. Limits are per authenticated user/IP bucket.
SIGNAL_SEARCH_RATE_LIMIT="30"
SIGNAL_SEARCH_RATE_WINDOW_MS="300000"
PROJECT_CREATE_RATE_LIMIT="10"
PROJECT_CREATE_RATE_WINDOW_MS="600000"
PROVIDER_RATE_LIMIT="10"
PROVIDER_RATE_WINDOW_MS="600000"
MEDIA_SEARCH_RATE_LIMIT="20"
MEDIA_SEARCH_RATE_WINDOW_MS="300000"
RENDER_RATE_LIMIT="6"
RENDER_RATE_WINDOW_MS="600000"
EDITOR_RENDER_RATE_LIMIT="6"
EDITOR_RENDER_RATE_WINDOW_MS="600000"

# M9 development-only Facebook publishing; production publishing is intentionally deferred.
FACEBOOK_API_VERSION="v25.0"
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""

# Gmail SMTP for all Voxora transactional emails. Requires 2-Step Verification + Google App Password.
# Use the authenticated account as sender; Gmail may rewrite unrelated From addresses.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_APP_PASSWORD=""
SMTP_FROM_NAME="Voxora"

# Paddle Billing - configure in sandbox first; never place API key or webhook secret in Vite/frontend environment.
PADDLE_ENV="sandbox"
PADDLE_API_KEY=""
PADDLE_CLIENT_TOKEN=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_PRICE_CREATOR=""
PADDLE_PRICE_STUDIO=""
# Optional per-transaction URL when sharing a Paddle account with BuildHire.
# Defaults to AUTH_PUBLIC_URL + /checkout. Do not replace the account default payment link.
PADDLE_CHECKOUT_URL="https://usevoxora.online/checkout"


# Website to Video Batch 2B.2 (opt-in paid AI illustration; no generic stock fallback).
# AI generation is OFF until explicitly enabled. Gemini key stays in server/.env.
VOXORA_MARKETING_AI_IMAGES_ENABLED=false
VOXORA_MARKETING_IMAGE_MODEL=gemini-3.1-flash-lite-image
VOXORA_MARKETING_IMAGE_TIMEOUT_MS=45000
