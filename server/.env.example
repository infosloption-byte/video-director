# Copy to .env and fill in for local dev. See docs/BUILD_PLAN.md §10.
DATABASE_URL="mysql://user:pass@localhost:3306/helix"
PORT=4000
# Optional: set true to refresh suggested signals immediately on API startup.
# The scheduled 4-hour refresh remains enabled either way.
SIGNALS_SCRAPE_ON_START=false

# M2 search sources. Semantic Scholar is free without a key.
TAVILY_API_KEY=""
BRAVE_API_KEY=""

# M3 research brief. Required for Gemini-backed research.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
