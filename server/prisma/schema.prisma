// Helix — Prisma schema (MySQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum SignalOrigin {
  suggested
  search
}

enum SourceType {
  rss
  hacker_news
  arxiv
  semantic_scholar
  tavily
  brave
}

enum SourceReliability {
  peer_reviewed
  ai_search
  general_web
}

enum SignalStatus {
  new
  used
  archived
}

model Signal {
  id                 String             @id @default(uuid())
  origin             SignalOrigin       @default(suggested)
  sourceType         SourceType
  sourceReliability  SourceReliability  @map("source_reliability")
  searchQuery        String?            @map("search_query")
  rank               Int?
  category           String
  heatPct             String?           @map("heat_pct")
  heatScore           Decimal?           @map("heat_score") @db.Decimal(6, 2)
  title              String
  description        String?            @db.Text
  whyReasoning       String             @map("why_reasoning") @db.Text
  sourceName         String?            @map("source_name")
  sourceUrl           String?            @map("source_url") @db.Text
  rawContent         String?            @map("raw_content") @db.LongText
  status             SignalStatus       @default(new)
  scrapedAt          DateTime           @default(now()) @map("scraped_at")
  projects           Project[]

  @@map("signals")
}

enum ProjectStatus {
  researching
  setup
  storyboard
  finalize
  rendering
  published
}

model Project {
  id                    String              @id @default(uuid())
  userId                String              @map("user_id")
  signalId              String              @map("signal_id")
  title                 String?
  researchSummary       String?             @map("research_summary") @db.Text
  researchSources       Json?               @map("research_sources")
  monetizationFlags     Json?               @map("monetization_flags")
  scriptLengthSeconds   Int?                @map("script_length_seconds")
  suggestedLengthSeconds Int?               @map("suggested_length_seconds")
  selectedFramework     String?             @map("selected_framework")
  frameworkReasoning    String?             @map("framework_reasoning") @db.Text
  suggestedFramework    String?             @map("suggested_framework")
  tone                  String?
  suggestedTone         String?             @map("suggested_tone")
  audienceLevel         String?
  seoCaption            String?             @map("seo_caption") @db.Text
  durationSeconds       Decimal?            @map("duration_seconds") @db.Decimal(5, 1)
  cuts                  Int?
  status                ProjectStatus       @default(researching)
  renderUrl             String?             @map("render_url") @db.Text
  createdAt             DateTime            @default(now()) @map("created_at")
  signal                Signal              @relation(fields: [signalId], references: [id])
  scenes                ProjectScene[]
  exports               ProjectExport[]
  editor                ProjectEditor?
  media                 ProjectMedia[]
  versions              ProjectVersion[]
  reviewLinks           ProjectReviewLink[]
  activities            ProjectActivity[]
  researchSessions      ResearchSession[]

  @@map("projects")
}

model ResearchSession {
  id          String            @id @default(uuid())
  projectId   String            @map("project_id")
  version     Int               @default(1)
  status      String            @db.VarChar(40)
  startedAt   DateTime          @default(now()) @map("started_at")
  completedAt DateTime?         @map("completed_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plan        ResearchPlan?
  sources     ResearchSource[]
  evidence    ResearchEvidence[]
  claims      ResearchClaim[]
  conflicts   ResearchConflict[]

  @@index([projectId, createdAt])
  @@index([projectId, status])
  @@map("research_sessions")
}

model ResearchPlan {
  id             String         @id @default(uuid())
  sessionId      String         @unique @map("session_id")
  lanes          Json
  queriesPlanned Int            @default(0) @map("queries_planned")
  queriesRun     Int            @default(0) @map("queries_run")
  createdAt      DateTime       @default(now()) @map("created_at")
  session        ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("research_plans")
}

model ResearchSource {
  id               String          @id @default(uuid())
  sessionId        String          @map("session_id")
  sourceIndex      Int             @map("source_index")
  url              String          @db.Text
  canonicalUrl     String?         @map("canonical_url") @db.Text
  title            String?         @db.Text
  publisher        String?
  sourceClass      String?         @map("source_class") @db.VarChar(60)
  reliability      String?         @db.VarChar(60)
  publishedAt      DateTime?       @map("published_at")
  retrievedAt      DateTime        @default(now()) @map("retrieved_at")
  readStatus       String          @map("read_status") @db.VarChar(30)
  readExcerpt      String?         @map("read_excerpt") @db.Text
  contentHash      String?         @map("content_hash") @db.Char(64)
  authorityScore   Int?            @map("authority_score")
  relevanceScore   Int?            @map("relevance_score")
  evidenceScore    Int?            @map("evidence_score")
  recencyScore     Int?            @map("recency_score")
  independenceScore Int?           @map("independence_score")
  transparencyScore Int?           @map("transparency_score")
  session          ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evidence         ResearchEvidence[]
  claimLinks       ResearchClaimSource[]

  @@unique([sessionId, sourceIndex])
  @@index([sessionId, readStatus])
  @@index([sessionId, sourceClass])
  @@map("research_sources")
}

model ResearchEvidence {
  id           String          @id @default(uuid())
  sessionId    String          @map("session_id")
  sourceId     String          @map("source_id")
  evidenceIndex Int            @map("evidence_index")
  passageText  String          @db.Text
  startOffset  Int?            @map("start_offset")
  endOffset    Int?            @map("end_offset")
  locator      String?         @db.VarChar(255)
  evidenceType String?         @map("evidence_type") @db.VarChar(50)
  createdAt    DateTime        @default(now()) @map("created_at")
  session      ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  source       ResearchSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  claimLinks   ResearchClaimEvidence[]

  @@unique([sessionId, evidenceIndex])
  @@index([sourceId])
  @@map("research_evidence")
}

model ResearchClaim {
  id                 String               @id @default(uuid())
  sessionId          String               @map("session_id")
  claimIndex         Int                  @map("claim_index")
  claimText          String               @db.Text
  evidenceLevel      String?              @map("evidence_level") @db.VarChar(50)
  modelConfidence    Int?                 @map("model_confidence")
  verifiedConfidence Int?                 @map("verified_confidence")
  verificationStatus String               @map("verification_status") @db.VarChar(40)
  createdAt           DateTime             @default(now()) @map("created_at")
  session             ResearchSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourceLinks         ResearchClaimSource[]
  evidenceLinks       ResearchClaimEvidence[]
  verification        ResearchVerification?
  conflictsLeft       ResearchConflict[]  @relation("conflict_left")
  conflictsRight      ResearchConflict[]  @relation("conflict_right")

  @@unique([sessionId, claimIndex])
  @@index([sessionId, verificationStatus])
  @@map("research_claims")
}

model ResearchClaimSource {
  claimId  String         @map("claim_id")
  sourceId String         @map("source_id")
  claim    ResearchClaim  @relation(fields: [claimId], references: [id], onDelete: Cascade)
  source   ResearchSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([claimId, sourceId])
  @@index([sourceId])
  @@map("research_claim_sources")
}

model ResearchClaimEvidence {
  claimId    String           @map("claim_id")
  evidenceId String           @map("evidence_id")
  claim      ResearchClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidence   ResearchEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([claimId, evidenceId])
  @@index([evidenceId])
  @@map("research_claim_evidence")
}

model ResearchVerification {
  id                  String         @id @default(uuid())
  claimId             String         @unique @map("claim_id")
  corroborationScore  Int            @default(0) @map("corroboration_score")
  contradictionScore  Int            @default(0) @map("contradiction_score")
  authorityScore      Int            @default(0) @map("authority_score")
  relevanceScore      Int            @default(0) @map("relevance_score")
  evidenceQualityScore Int           @default(0) @map("evidence_quality_score")
  recencyScore        Int            @default(0) @map("recency_score")
  independenceScore   Int             @default(0) @map("independence_score")
  transparencyScore   Int             @default(0) @map("transparency_score")
  traceable           Boolean         @default(false)
  notes               String?         @db.Text
  checkedAt           DateTime        @default(now()) @map("checked_at")
  claim               ResearchClaim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([authorityScore])
  @@index([corroborationScore])
  @@map("research_verifications")
}

model ResearchConflict {
  id              String         @id @default(uuid())
  sessionId       String         @map("session_id")
  leftClaimId     String         @map("left_claim_id")
  rightClaimId    String         @map("right_claim_id")
  overlapScore    Int            @map("overlap_score")
  reason          String         @db.Text
  resolution      String?        @db.Text
  status          String         @default("open") @db.VarChar(30)
  createdAt       DateTime       @default(now()) @map("created_at")
  session         ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  leftClaim       ResearchClaim  @relation("conflict_left", fields: [leftClaimId], references: [id], onDelete: Cascade)
  rightClaim      ResearchClaim  @relation("conflict_right", fields: [rightClaimId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@map("research_conflicts")
}

model ProjectScene {
  id               String        @id @default(uuid())
  projectId        String        @map("project_id")
  sceneOrder       Int           @map("scene_order")
  title            String?
  spokenText       String        @map("spoken_text") @db.Text
  durationSeconds  Decimal?      @map("duration_seconds") @db.Decimal(4, 1)
  whyLine          String?       @map("why_line") @db.Text
  whyPicture       String?       @map("why_picture") @db.Text
  brollSearchTerm  String?       @map("broll_search_term")
  audioUrl         String?       @map("audio_url") @db.Text
  wordTimestamps   Json?         @map("word_timestamps")
  project          Project       @relation(fields: [projectId], references: [id])
  assets           SceneAsset[]

  @@map("project_scenes")
}

enum ExportKind {
  mp4
  srt
  script_txt
}

model ProjectExport {
  id        String      @id @default(uuid())
  projectId String      @map("project_id")
  kind      ExportKind
  fileUrl   String      @map("file_url") @db.Text
  createdAt DateTime    @default(now()) @map("created_at")
  project   Project     @relation(fields: [projectId], references: [id])
}

enum ProjectMediaKind {
  video
  image
  audio
  caption
}

enum ProjectMediaOrigin {
  upload
  generated
  external
  storyboard
}

enum ProjectMediaStatus {
  processing
  ready
  failed
}

model ProjectMedia {
  id                String            @id @default(uuid())
  projectId         String            @map("project_id")
  kind              ProjectMediaKind
  origin             ProjectMediaOrigin
  status             ProjectMediaStatus @default(ready)
  title              String
  filename          String?
  mimeType          String?           @map("mime_type")
  sizeBytes         BigInt?           @map("size_bytes")
  durationSeconds   Decimal?          @map("duration_seconds") @db.Decimal(8, 3)
  width             Int?
  height            Int?
  mediaUrl          String            @map("media_url") @db.Text
  proxyUrl          String?           @map("proxy_url") @db.Text
  thumbnailUrl      String?            @map("thumbnail_url") @db.Text
  sourceUrl         String?            @map("source_url") @db.Text
  provider          String?
  providerAssetId   String?            @map("provider_asset_id")
  storageKey        String?            @map("storage_key") @db.Text
  proxyStorageKey   String?            @map("proxy_storage_key") @db.Text
  thumbnailKey      String?            @map("thumbnail_key") @db.Text
  processingError   String?            @map("processing_error") @db.Text
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind])
  @@index([projectId, origin])
  @@index([provider])
  @@index([providerAssetId])
  @@map("project_media")
}

enum ProjectMediaOrigin {
  upload
  generated
  external
  storyboard
}
